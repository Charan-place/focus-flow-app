# Copy to .env and fill in. Never commit .env.

# Server
PORT=4000

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/focusflow?retryWrites=true&w=majority

# Secret for signing our own JWTs. Use a long random string.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth — the Web client ID from Google Cloud Console (used to verify id tokens)
GOOGLE_WEB_CLIENT_ID=REPLACE_GOOGLE_WEB_CLIENT_ID
